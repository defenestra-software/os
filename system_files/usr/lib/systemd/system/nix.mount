# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Nix store bind mount
DefaultDependencies=no
After=var.mount systemd-tmpfiles-setup.service
Before=sysinit.target nix-daemon.service nix-daemon.socket
RequiresMountsFor=/var
ConditionPathIsDirectory=/var/nix

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=sysinit.target
