[Unit]
Description=Compose /run/opengl-driver (host GL + Nix Mesa hybrid)
After=nix.mount systemd-tmpfiles-setup.service
RequiresMountsFor=/nix /var

[Service]
Type=oneshot
ExecStart=/usr/libexec/defenestra-opengl-compose

[Install]
WantedBy=sysinit.target
