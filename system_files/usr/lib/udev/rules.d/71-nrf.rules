# 71-nrf.rules
ACTION=="remove", GOTO="nrf_rules_end"

# uaccess applies only to active seat sessions. plugdev covers SSH and headless use.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1915", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Flag USB CDC ACM devices, handled later in 99-mm-nrf-blacklist.rules
KERNEL=="ttyACM[0-9]*", SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1915", MODE="0660", GROUP="dialout", TAG+="uaccess", ENV{NRF_CDC_ACM}="1"

LABEL="nrf_rules_end"
