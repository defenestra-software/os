#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Enable signature enforcement for unverified installs, using the same
# origin rewrite the installer does. No download or reboot: the next update
# will be the first one verified. A staged unverified image will get fixed on
# boot

set -euo pipefail

# bootc omits .signature for any origins that skips verification.
image="$(bootc status --json | jq -r '
    .status.booted.image.image
    | select(.transport == "registry" and .signature == null)
    | .image')"

case "$image" in
ghcr.io/defenestra-software/*) ;;
*) exit 0 ;;
esac

# temporaly privately mount to allow signing
# shellcheck disable=SC2016
unshare --mount --propagation private -- sh -c '
    mount -o remount,rw /sysroot &&
    exec bootc switch --mutate-in-place --enforce-container-sigpolicy --transport registry "$1"
' sh "$image"
