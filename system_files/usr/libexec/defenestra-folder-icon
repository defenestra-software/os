#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Preserve icons users has chosen themselves.
set -euo pipefail

dir="${1:?usage: $0 <dir> <icon>}"
icon="${2:?usage: $0 <dir> <icon>}"

if ! gio info -a metadata::custom-icon-name "${dir}" | grep -q 'custom-icon-name:'; then
    gio set "${dir}" metadata::custom-icon-name "${icon}"
    touch -c -r "${dir}" "${dir}"
fi
