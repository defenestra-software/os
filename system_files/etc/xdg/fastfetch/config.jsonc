{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/defenestra/fastfetch/logo.txt",
        "padding": { "top": 1, "left": 2 }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "host", "key": "Host" },
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
